    {
      "id": 9,
      "type": "barchart",
      "title": "모듈별 단위 테스트 결과",
      "description": "상단 0건 모듈 선택으로 표시·숨김을 전환한다. 기본은 숨김이며 이 그래프에만 적용한다. 원본 지표·상단 요약·상세 표는 유지한다. 실행된 모듈의 성공·실패·오류·건너뜀은 모두 표시한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "erpmsa_unit_test_cases{job=\"spring_unit_tests\",project=\"$project\",source=\"$source\",branch=\"$branch\",module=~\"$module\",result=~\"passed|failed|errors|skipped\"} and on (project, source, branch, module) (erpmsa_unit_test_cases{job=\"spring_unit_tests\",project=\"$project\",source=\"$source\",branch=\"$branch\",module=~\"$module\",result=\"total\"} >= ${zero_modules:raw})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "result",
            "rowField": "module",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "showValue": "never",
        "stacking": "normal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
