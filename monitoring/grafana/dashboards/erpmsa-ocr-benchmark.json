    {
      "id": 5,
      "type": "barchart",
      "title": "지연 비교 (초, 낮을수록 좋음)",
      "description": "지표별로 실행을 나란히 비교한다. 파랑 before*, 주황 after*.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(ocr_benchmark_latency_seconds{run=~\"$run\",stat=~\"p50|p95|max\",phase=~\"warm|cold\"} unless ocr_benchmark_latency_seconds{phase=\"cold\",stat=\"p95\"}, \"metric\", \" \", \"phase\", \"stat\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{run}}",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "run",
            "rowField": "metric",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.05,
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "fullHighlight": false,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
