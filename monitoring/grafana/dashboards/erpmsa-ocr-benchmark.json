{
  "uid": "erpmsa-ocr-benchmark",
  "title": "ErpMSA OCR Benchmark",
  "description": "ocrserver/eval/benchmark.py --pushgateway 결과. 로컬(Before)과 Modal(After) 비교용.",
  "tags": [
    "ocr",
    "benchmark"
  ],
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ocr_benchmark_info{run=~\"before-local-q8|after-modal-l4-healthfix\"}, run)",
          "refId": "run"
        },
        "definition": "label_values(ocr_benchmark_info{run=~\"before-local-q8|after-modal-l4-healthfix\"}, run)",
        "multi": true,
        "includeAll": true,
        "allValue": "before-local-q8|after-modal-l4-healthfix",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "웜 지연 p50",
      "description": "워밍업 후 반복 요청의 중앙값. 낮을수록 좋다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr_benchmark_latency_seconds{run=~\"$run\",phase=\"warm\",stat=\"p50\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{run}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^before.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^after.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "콜드 스타트 p50",
      "description": "서버·컨테이너가 내려간 상태의 첫 요청. Modal은 GPU 배정 대기 시간도 포함된다.",
