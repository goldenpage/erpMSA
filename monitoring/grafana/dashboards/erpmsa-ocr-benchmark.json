    },
    {
      "id": 11,
      "type": "barchart",
      "title": "실제 서류 vs 합성 서류 (높을수록 좋음)",
      "description": "실제 서류는 대표자 일치만 표시한다. 실제 자동승인율·후보 재현율·상호 일치는 사용자 요청으로 표시에서 제외했다. 합성 서류는 인쇄체·가짜 데이터라 실제 서류보다 높게 나올 수 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(ocr_benchmark_subset_ratio{run=~\"$run\",metric=~\"auto_accept_rate|candidate_recall|companyName|representativeName\"} unless ocr_benchmark_subset_ratio{subset=\"real\",metric=~\"auto_accept_rate|candidate_recall|companyName\"}, \"row\", \" · \", \"subset\", \"metric\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{run}}",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "run",
            "rowField": "row",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.05,
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "fullHighlight": false,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none"
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^before.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^after.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "real · representativeName": {
                        "text": "실제 대표자 일치",
                        "index": 3
                      },
                      "synthetic · auto_accept_rate": {
                        "text": "합성 자동승인율",
                        "index": 4
                      },
                      "synthetic · candidate_recall": {
                        "text": "합성 후보 재현율",
                        "index": 5
                      },
                      "synthetic · companyName": {
                        "text": "합성 상호 일치",
                        "index": 6
                      },
                      "synthetic · representativeName": {
                        "text": "합성 대표자 일치",
                        "index": 7
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
