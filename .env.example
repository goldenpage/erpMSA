# 공통 서비스 설정
EUREKA_DEFAULT_ZONE=http://127.0.0.1:8761/eureka
EUREKA_SERVER_PORT=8761
GATEWAY_SERVER_PORT=7070
ACCOUNT_SERVER_PORT=7071
AUDIT_SERVER_PORT=7072

# AccountService 데이터베이스
DB_URL=jdbc:mariadb://localhost:3306/mydb
DB_USERNAME=account
DB_PASSWORD=

# AuditService 데이터베이스(Compose에서는 auditdb를 자동 생성)
AUDIT_DB_URL=jdbc:mariadb://localhost:3306/auditdb
AUDIT_DB_USERNAME=account

# AccountService Redis
REDIS_HOST=localhost
REDIS_PORT=3308
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# 데이터베이스 마이그레이션/JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
# 기존 로컬 mydb에 Flyway 이력이 없을 때 V1을 기준점으로 등록
FLYWAY_BASELINE_ON_MIGRATE=true

# Kafka: 호스트 서비스는 9094, Compose 서비스는 kafka:9092 사용
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ACCOUNT_LIFECYCLE_TOPIC=account.lifecycle.v1
KAFKA_ACCOUNT_LIFECYCLE_DLT_TOPIC=account.lifecycle.v1.DLT
KAFKA_AUDIT_GROUP_ID=audit-service-v1
OUTBOX_PUBLISH_DELAY=1s
OUTBOX_RETRY_DELAY=5s

# AccountService JWT
JWT_ISSUER=kosta-erp-account
JWT_AUDIENCE=kosta-erp-api
JWT_SECRET_BASE64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false

# Prometheus와 Grafana
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
GRAFANA_COOKIE_SECURE=false

# 선택 설정
ACCOUNT_USER_MESSAGE="AccountService Message"
