# 공통 서비스 설정
EUREKA_DEFAULT_ZONE=http://127.0.0.1:8761/eureka
EUREKA_SERVER_PORT=8761
GATEWAY_SERVER_PORT=7070
ACCOUNT_SERVER_PORT=7071
FOOD_MATERIAL_SERVER_PORT=7073
MENUS_SERVER_PORT=7072
NOTICES_SERVER_PORT=7074
BILLS_SERVER_PORT=7075
PURCHASE_SERVER_PORT=7076
DISPOSALS_SERVER_PORT=7077

# AccountService 데이터베이스
DB_URL=jdbc:mariadb://localhost:3306/mydb
DB_USERNAME=account
DB_PASSWORD=

# FoodMaterialsService 데이터베이스(Compose에서는 itemdb를 자동 생성)
FOOD_MATERIAL_DB_URL=jdbc:mariadb://localhost:3306/itemdb
FOOD_MATERIAL_DB_USERNAME=account
FOOD_MATERIAL_FLYWAY_BASELINE_ON_MIGRATE=false

# FoodMaterialsService 내부 재고 모듈: 기존 inventorydb와 migration 이력 유지
FOOD_MATERIAL_INVENTORY_DB_URL=jdbc:mariadb://localhost:3306/inventorydb
FOOD_MATERIAL_INVENTORY_DB_USERNAME=account
FOOD_MATERIAL_INVENTORY_FLYWAY_BASELINE_ON_MIGRATE=false
FOOD_MATERIAL_INVENTORY_DB_POOL_SIZE=10

# AccountService Redis
REDIS_HOST=localhost
REDIS_PORT=3308
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# 데이터베이스 마이그레이션/JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
# 기존 로컬 mydb에 Flyway 이력이 없을 때 V1을 기준점으로 등록
FLYWAY_BASELINE_ON_MIGRATE=true

# Kafka: 호스트 서비스는 9094, Compose 서비스는 kafka:9092 사용
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ACCOUNT_LIFECYCLE_TOPIC=account.lifecycle.v1
OUTBOX_PUBLISH_DELAY=1s
OUTBOX_RETRY_DELAY=5s

# AccountService JWT
JWT_ISSUER=kosta-erp-account
JWT_AUDIENCE=kosta-erp-api
JWT_SIGNING_KEY_ID=local-k1
JWT_PUBLIC_KEY_DIRECTORY=../secrets/jwt/public
JWT_PRIVATE_KEY_PATH=../secrets/jwt/private/local-k1.pem
JWT_PUBLIC_KEYS_HOST_DIR=./secrets/jwt/public
JWT_PRIVATE_KEY_HOST_FILE=./secrets/jwt/private/local-k1.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false

# Prometheus와 Grafana
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
GRAFANA_COOKIE_SECURE=false

# 선택 설정
ACCOUNT_USER_MESSAGE="AccountService Message"
